APP_NAME=Retorna Frete API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://retornafrete:retornafrete@db:5432/retornafrete
JWT_SECRET_KEY=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-me-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,exp://127.0.0.1:8081,retornafrete://
MAPBOX_TOKEN=
MAPBOX_DIRECTIONS_URL=https://api.mapbox.com/directions/v5/mapbox/driving
MAPBOX_GEOCODING_URL=https://api.mapbox.com/search/geocode/v6/reverse
OSRM_DIRECTIONS_URL=https://router.project-osrm.org/route/v1/driving
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=retorna-frete-fastapi/1.0
MERCADO_PAGO_ACCESS_TOKEN=replace-me-with-your-mercado-pago-token
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_NOTIFICATION_URL=https://your-api.example.com/api/payments/mercado-pago/webhook
MERCADO_PAGO_WEBHOOK_SECRET=replace-me-with-a-random-secret
MERCADO_PAGO_SUCCESS_URL=retornafrete://payment/success
MERCADO_PAGO_PENDING_URL=retornafrete://payment/pending
MERCADO_PAGO_FAILURE_URL=retornafrete://payment/failure
